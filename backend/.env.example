# MediaWiki / Wikipedia API
WIKI_API_URL=https://en.wikipedia.org/w/api.php
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php

# Wikimedia asks every client to identify itself. Change the contact address.
USER_AGENT=FindTheMissingConnections/0.1 (https://github.com/pshkarsngh/Wikitech_Project)

# PostgreSQL. Leave empty to run without a database (results are still returned,
# they are simply not cached).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/find_missing
DATABASE_URL=
DATABASE_ECHO=false

# Request limits
HTTP_TIMEOUT_SECONDS=20
# Wikimedia asks API clients to keep concurrent requests at 3 or fewer, and publishes a
# limit of 200 requests/minute for an unauthenticated client with a compliant User-Agent.
# One analysis costs roughly 25-35 requests, so this deployment can serve about 6-8
# analyses per minute in total. Do not raise this above 3 without a reason from
# https://www.mediawiki.org/wiki/Wikimedia_APIs/Rate_limits
MAX_CONCURRENT_REQUESTS=3
MAX_LINKS_PER_ARTICLE=500
MISSING_CHECK_BATCH_SIZE=50
ONE_WAY_MAX_TARGETS=25
CLASSIFY_MAX_ITEMS=20
MAP_NODE_LIMIT=40

# How long one analysis may run before it stops asking for more.
# The limits above bound each step but not the whole: 25-35 requests, a concurrency
# limit of 3 and a 20s timeout per request still add up to minutes, and a reader who
# navigates away does not stop them. This is the ceiling on the sum.
#
# When it is reached, /api/analyze returns what it has with `summary.aborted` set -
# the article's links and missing connections are real, the entity types and one-way
# check are whatever finished. The three list routes answer 504 instead, because a
# cut-short list is indistinguishable from an empty one.
#
# Keep this below `proxy_read_timeout` in frontend/nginx-proxy-api.conf (120s). If the
# two meet, nginx closes the connection at the moment the backend is about to write a
# body and the reader gets a bare 502 instead of the partial result.
ANALYSIS_DEADLINE_SECONDS=100

# Retention and caching
# How long a stored analysis is served before it is recomputed. A red link is a fact about
# Wikipedia that can change at any moment, so a cache with no expiry is a cache that is
# eventually wrong and never says so. Set to 0 to always recompute.
ANALYSIS_CACHE_TTL_SECONDS=3600
# How long an analysis run is kept before it is pruned. analysis_runs is the one table
# here that no natural bound applies to: articles and article_links are capped by the
# size of Wikipedia, this grows with request volume.
ANALYSIS_RUN_RETENTION_DAYS=30
ANALYSIS_RUN_PRUNE_EVERY=100

# Shared key for the routes that crawl Wikipedia. Leave empty to be open to everyone;
# that is the default and not a misconfiguration. Set it to any non-empty string and
# /api/analyze and /api/connections/* will refuse anything without a matching
# `X-Api-Key` header, which makes the deployment invite-only.
# This is not identity: everyone shares one key, and rotating the string is the only way
# to cut off a leaked one. See docs/ARCHITECTURE.md section 10.1.
# GET /api/health reports which mode a deployment is in, as `auth_required`.
ANALYSIS_API_KEY=

# Frontend origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
