# Copy to .env next to docker-compose.production.yml and fill in every value.
# .env is already covered by the repository .gitignore. Never commit it.

# --- Release identity -------------------------------------------------------
# The tag both images are deployed at, and the rollback lever: change it and `up -d`.
#
# Use a name that means something - a version, or the commit sha. Do NOT use `latest`:
# with no registry (ROLLBACK.md §6) the image only exists on the host, and `latest` is
# overwritten by every build, so there is then no previous tag to roll back to.
RELEASE_TAG=0.1.0
API_IMAGE=find-missing-api
WEB_IMAGE=find-missing-web
WEB_PORT=80

# --- Database ---------------------------------------------------------------
POSTGRES_DB=find_missing
POSTGRES_USER=postgres
# No default on purpose. A production password that falls back to a known string is
# worse than a failed deploy, so compose refuses to start without it.
#
# Generate with `openssl rand -hex 32`, NOT `openssl rand -base64 32`. The API builds
# its connection string by substituting this value into a URL, and base64 routinely
# contains `/`, `+` and `=`; a `/` terminates the authority component, the URL stops
# parsing, and the app silently loses its cache. Hex is URL-safe and needs no encoding.
POSTGRES_PASSWORD=

# --- Application ------------------------------------------------------------
# Wikimedia's API policy asks every client to identify itself with a real
# contact address. The default in backend/app/config.py points at the source
# repository, which is not a contact for a deployed instance.
USER_AGENT=FindTheMissingConnections/1.0 (https://your-domain.example; you@example.com)

# The SPA is served same-origin through nginx, so cross-origin callers are not
# expected. Leave as [] unless something else calls the API directly. Must be
# JSON, e.g. ["https://admin.example.com"]
CORS_ORIGINS=[]
